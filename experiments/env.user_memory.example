# Copy to experiments/.env.user_memory and replace every placeholder.
# This file contains configuration names only. Never commit the populated copy.
# Provider credentials referenced by config/user_memory.yaml.
HESM_EVAL_TOKEN=<random-local-bearer-token-at-least-24-characters>
HESM_EVAL_MEMORY_API_KEY=<memory-model-api-key>
HESM_EVAL_MEMORY_BASE_URL=<memory-model-base-url>
HESM_EVAL_EMBEDDING_API_KEY=<embedding-model-api-key>
HESM_EVAL_EMBEDDING_BASE_URL=<embedding-model-base-url>
# HESM_EVAL_URL is derived from YAML host/port by the launcher.
ANSWER_MODEL=gpt-4.1-mini-2025-04-14
ANSWER_API_KEY=<answer-model-api-key>
ANSWER_BASE_URL=<answer-model-base-url>
EVAL_MODEL=gpt-4o-mini-2024-07-18
EVAL_API_KEY=<judge-model-api-key>
EVAL_BASE_URL=<judge-model-base-url>
HESM_EVAL_TIMEOUT=3600
LLM_WORKERS=2
TOPK=20
ANONYMIZED_TELEMETRY=False
PYTHONUTF8=1
